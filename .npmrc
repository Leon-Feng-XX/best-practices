# Package registry — default is https://registry.npmjs.org/
# Uncomment to override (e.g. China mirror):
# registry=https://registry.npmmirror.com

# Authentication tokens — NEVER commit real values.
# Use environment variable interpolation instead:
# //registry.example.com/:_authToken=${NPM_TOKEN}
# //npm.pkg.github.com/:_authToken=${GITHUB_TOKEN}

# All other pnpm settings belong in pnpm-workspace.yaml (pnpm 10+ convention).
# See https://pnpm.io/settings for the full list.
